# Node >=22: node --env-file=.env src/server.mjs
DUMATE_TOKEN=replace-with-a-random-token-of-at-least-32-characters
DUMATE_UPSTREAM=http://127.0.0.1:9999
DUMATE_HOST=127.0.0.1
DUMATE_PORT=9998
DUMATE_TIMEOUT_MS=75000
# Optional, if the original backend requires Bearer auth. Never forward client headers.
DUMATE_UPSTREAM_TOKEN=
