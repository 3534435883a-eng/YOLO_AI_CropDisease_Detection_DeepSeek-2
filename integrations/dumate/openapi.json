  "components": {
    "securitySchemes": {
      "adapterBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "管理员设置DUMATE_TOKEN；不是原后端用户令牌"
      }
    },
    "schemas": {
      "Trace": {
        "type": "object",
        "required": [
          "evidenceId",
          "inputSha256",
          "calls"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "inputSha256": {
            "type": "string"
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "requestedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "elapsedMs": {
                  "type": "integer"
                },
                "requestSha256": {
                  "type": "string"
                },
                "responseSha256": {
                  "type": "string"
                },
                "resultCode": {
                  "type": "string"
                },
                "errorCode": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Matrix": {
        "type": "object",
        "required": [
          "P0_NONE",
          "P1_FIXED_MANUAL",
          "P2_RULE_ENGINE",
          "P3_AGENT",
          "P4_PID_PROPORTIONAL",
          "P5_PID_PI",
          "P6_PID_FULL"
        ],
        "additionalProperties": false,
        "properties": {
          "P0_NONE": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P1_FIXED_MANUAL": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P2_RULE_ENGINE": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P3_AGENT": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P4_PID_PROPORTIONAL": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P5_PID_PI": {
            "$ref": "#/components/schemas/Metrics"
          },
          "P6_PID_FULL": {
            "$ref": "#/components/schemas/Metrics"
          }
        }
      },
      "Metrics": {
        "type": "object",
        "required": [
          "marketableYieldKg",
          "waterUsedM3",
          "energyKWh",
          "costYuan",
          "profitYuan",
          "highTemperatureMinutes",
          "highHumidityMinutes",
          "diseasePressureIntegral",
          "constraintViolations",
          "finalSeverityTotal"
        ],
        "additionalProperties": false,
        "properties": {
          "marketableYieldKg": {
            "type": "number",
            "description": "模型指标；单位：kg"
          },
          "waterUsedM3": {
            "type": "number",
            "description": "模型指标；单位：m³"
          },
          "energyKWh": {
            "type": "number",
            "description": "模型指标；单位：kWh"
          },
          "costYuan": {
            "type": "number",
            "description": "模型指标；单位：元"
          },
          "profitYuan": {
            "type": "number",
            "description": "模型指标；单位：元"
          },
          "highTemperatureMinutes": {
            "type": "number",
            "description": "模型指标；单位：分钟"
          },
          "highHumidityMinutes": {
            "type": "number",
            "description": "模型指标；单位：分钟"
          },
          "diseasePressureIntegral": {
            "type": "number",
            "description": "模型指标；单位：模型积分"
          },
          "constraintViolations": {
            "type": "number",
            "description": "模型指标；单位：次"
          },
          "finalSeverityTotal": {
            "type": "number",
            "description": "模型指标；单位：模型严重度"
          }
        }
      },
      "AnalyzeResult": {
        "type": "object",
        "required": [
          "analysisId",
          "draft",
          "riskClues",
          "requiresHumanReview",
          "trace",
          "boundaries",
          "resultSha256"
        ],
        "properties": {
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace": {
            "$ref": "#/components/schemas/Trace"
          },
          "resultSha256": {
            "type": "string"
          },
          "analysisId": {
            "type": "string",
            "format": "uuid"
          },
