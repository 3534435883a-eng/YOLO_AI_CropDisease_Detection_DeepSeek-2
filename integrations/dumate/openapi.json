    "/v1/agri/evaluate": {
      "post": {
        "operationId": "agri_evaluate",
        "summary": "agri.evaluate",
        "tags": [
          "农业研究与虚拟仿真"
        ],
        "description": "固定番茄参考场景P0–P6对照；不使用解析农情作为初始条件。",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "description": "同一请求重复提交复用原键；不确定POST禁止自动换键重试。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "analysisId",
                  "acknowledgeReferenceScenario"
                ],
                "properties": {
                  "analysisId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "acknowledgeReferenceScenario": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "default": 20250419
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 56,
                    "default": 56
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实际工具结果或存档复用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
