{
  "openapi": "3.0.3",
  "info": {
    "title": "DuMate Agricultural Research Adapter",
    "version": "0.1.0",
    "description": "仅三能力；固定参考仿真、用户草稿需复核、无实棚验证。不会暴露原用户/文件/设备接口。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9998",
      "description": "本机联调；云端节点需管理员配置HTTPS地址"
    }
  ],
  "security": [
    {
      "adapterBearer": []
    }
  ],
  "paths": {
    "/v1/agri/analyze": {
      "post": {
        "operationId": "agri_analyze",
        "summary": "agri.analyze",
        "tags": [
          "农业研究与虚拟仿真"
        ],
        "description": "仅农业研究；不操作真实设备。",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "description": "同一请求重复提交复用原键；不确定POST禁止自动换键重试。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实际工具结果或存档复用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "requestId",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "$ref": "#/components/schemas/AnalyzeResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "失败；HTTP 400，见error.code；上游POST超时结果可能不确定",
