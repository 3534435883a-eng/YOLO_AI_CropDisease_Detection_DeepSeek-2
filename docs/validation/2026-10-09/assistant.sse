data:{"type":"context","stepNo":0,"toolName":"simulation.snapshot","message":"已关联当前M3大棚","data":{"simulationRunId":"0d01c93d-9794-4dc4-b875-073778913055","snapshot":{"at":"2025-04-19T17:00","date":"2025-04-19","cursor":10,"receivedAt":"2026-10-08T20:04:05.179+08:00[Asia/Shanghai]","gdd":4.7143745416666665,"split":"online","environment":{"at":"2025-04-19T16:30:00","temperatureC":30.149998,"airHumidityPct":19.82,"co2Ppm":438.0,"lightRaw":7.85,"soilMoistureVwcPct":54.399999,"estimated":false,"origin":"ck-back","observedAt":"2025-04-19T16:01:33+08:00","source":{"file":"2025/2025/202504/raw_data/sensor_data/sensor1.xlsx","sheet":"2025-04-19","row":34,"columns":{"temperatureC":"空气温度（对照2）后","airHumidityPct":"相对湿度（对照2）后","co2Ppm":"二氧化碳（对照2）后","lightRaw":"光照（对照2）后","soilMoistureVwcPct":"土壤水分（对照2）"}}},"risk":{"vpdKpa":3.4314693249588593,"dewPointC":4.5997606668636815,"dewPointMarginC":25.55023733313632,"highTemperatureMinutes24h":300.0,"highHumidityMinutes24h":0.0,"highVpdMinutes24h":300.0,"heatDegreeHours24h":18.144989000000002,"windowMinutes":300,"alerts":[{"code":"VPD_HIGH","title":"VPD偏高","level":"HIGH","value":3.4314693249588593,"threshold":2.0,"unit":"kPa","durationMinutes":300,"advice":"检查温湿度和根区水分，综合评估蒸腾压力","basis":"由空气温湿度计算，工程阈值","estimatedInput":false,"origin":"ck-back"}],"changes":[],"riskLevel":"HIGH","validatedProbability":false},"originalHeightCm":48.70875293432962,"correctedHeightCm":48.70875293432962,"predictedHeightCm":48.70875293432962,"linearHeightCm":0,"measurementCount":0,"observedHeightCm":null,"leafReference":{"laiRaw":null,"ldwRaw":null,"assimilated":false,"unitStatus":"INSTRUMENT_BASIS_NOT_ALIGNED"},"growth":{"lai":1.3025122918505312,"wTotal":156.793400383748,"wFruit":0.0,"fruitSetRate":0.0025693446017803845,"fruitCount":0,"singleFruitWeightG":0.0,"stage":"SEEDLING","temperatureFactor":0.6928574285714286,"co2Factor":1.03325,"waterFactor":1.0,"plantHeightCm":48.70875293432962,"fieldValidated":false,"soilStressNeutralAssumption":true,"lightUnitAssumption":"raw klux -> lux x1000 -> PPFD x0.0185"},"scenario":{"runId":"0d01c93d-9794-4dc4-b875-073778913055","version":16,"seed":-224638248181033054,"tick":10,"at":"2025-04-19T17:00","source":"SIMULATED","autoEvents":false,"autoActuation":true,"pending":false,"farmTaskId":"880bb12c-444e-4180-83e2-8c52e88bdf80","environment":{"at":"2025-04-19T16:30:00","temperatureC":29.21597957913973,"airHumidityPct":94.939444254516,"co2Ppm":438.0,"lightRaw":1.5875141359212792,"soilMoistureVwcPct":29.863797934398633,"estimated":true,"origin":"SIMULATED_M3_ANCHORED","observedAt":"2025-04-19T16:01:33+08:00","ppfd":29.369011514543665,"absoluteHumidityGm3":27.597188348746943,"windMps":0.0,"rainMmH":7.751077417745473,"simulatedBoundaryTemperatureC":30.149998,"simulatedBoundaryHumidityPct":90.19055982194152,"waterStressNeutral":false,"rootWaterOrigin":"SIMULATED_ROOT_WATER_BALANCE","rootWaterStressFactor":1.0,"outsideBoundaryMeasured":false},"risk":{"vpdKpa":0.2052534093837146,"dewPointC":28.31892624356055,"dewPointMarginC":0.8970533355791801,"highTemperatureMinutes24h":270.0,"highHumidityMinutes24h":120.0,"highVpdMinutes24h":90.0,"heatDegreeHours24h":11.070181717305555,"windowMinutes":300,"alerts":[{"code":"WARM_LEAF_WET","title":"叶斑类病害湿润条件提示","level":"MEDIUM","durationMinutes":37.0,"advice":"复查病斑是否扩展；病叶处置和病因判断需要人工登记","basis":"20–30°C且冠层湿润代理≥0.55；未标定条件规则，不能诊断病害","origin":"SIMULATED_CONDITION_RULE","estimatedInput":true}],"changes":[{"code":"HEAT","title":"高温暴露","level":"MEDIUM","value":29.21597957913973,"threshold":29.0,"unit":"°C","durationMinutes":30,"advice":"检查通风和遮阳，复核冠层温度","basis":"项目工程阈值，非广辉201标定值","estimatedInput":true,"origin":"SIMULATED_M3_ANCHORED"}],"riskLevel":"MEDIUM","validatedProbability":false},"weather":{"id":"0d01c93d-9794-4dc4-b875-073778913055-event-1","type":"OVERCAST","title":"连续阴雨","startTick":0,"startedAt":"2025-04-19T12:00","temperatureOffsetC":0.0,"humidityBoundaryPct":90.19055982194153,"lightMultiplier":0.2789394484377385,"windMps":0.0,"rainMmH":7.751077417745473,"endTick":30,"endsAt":"2025-04-20T03:00","source":"SIMULATED"},"decision":{"feedback":{"at":"2025-04-19T15:00","temperatureDifferenceC":0.6863445408360285,"humidityDifferencePct":16.915275624456044,"soilMoistureDifferenceVwcPct":0.02236325547519158,"applicationStatus":"APPLIED_TO_SIMULATION","source":"MODEL_COMPARISON","fieldValidated":false,"detailsSummarized":true},"status":"UNRESOLVED","requestId":"bcccd143-dd15-43cb-940b-d569b05aff22","question":"请结合当前农情、根区与设备健康处理事件，观察改善与代价","version":9,"applyRequested":true,"startedAt":"2025-04-19T14:00","plan":{"summary":"当前正处连续阴雨的高温时段：棚内31.9°C、湿度62%，根区29.9%vol尚属适宜，但高温已持续约2小时，是现在最主要的矛盾。早疫病只是已保存的检测候选，褐斑属于人工报告症状，不能当作确诊或病原量…（摘要省略）","reason":"棚内温度31.9°C已越过项目29°C高温保护线，所以不能开加热；湿度不高、VPD约1.8kPa，蒸发降温条件尚可，但阴雨下外界空气湿度达90%，湿帘效力会明显打折，不能指望它给固定降温幅度。根区含水…（摘要省略）","expected":"在保持通风换气的条件下压低棚内温度、缓解持续高温暴露，同时避免根区过湿和叶面长时间润湿；阴雨高湿下湿帘降温幅度有限。","citationNumbers":[4],"check":"两步后（约30分钟后）复查棚温是否回落、湿度与叶面是否结露、根区含水率变化；4小时湿润窗口内人工复查已报告褐斑和早疫病候选叶片是否扩展、有无新斑，病斑面积与病因需人工登记，不能因环境改善判定症状消失。","actions":[{"duty":0.0,"durationSteps":2,"device":"HEATING"}],"modelReturned":true,"taskId":"880bb12c-444e-4180-83e2-8c52e88bdf80","taskEvidenceIds":["fca4ad2f-8135-4205-976b-360b61754e4e"]},"provider":"DeepSeek","constraints":[],"executedAt":"2025-04-19T14:00","executedDevices":{"HEATING":0.0,"IRRIGATION":0.0,"VENTILATION":0.0,"SUPPLEMENTAL_LIGHT":0.0,"SHADE":0.5,"CO2_SUPPLY":0.0,"ROOF_VENT":0.6,"EXHAUST_FAN":0.6,"COOLING_PAD":0.0,"CIRCULATION_FAN":0.5},"snapshotReference":{"sha256":"d3455829dee0aaa4d4d55f7b03b95518e3adaf6f2d68acfe097e6fb998d7dd6f","at":"2025-04-19T15:00","fullFeedbackRetained":true,"catalogKey":"decisionSnapshots.d3455829dee0aaa4d4d55f7b03b95518e3adaf6f2d68acfe097e6fb998d7dd6f"}},"responseModelVersion":"m3-scenario-agronomy-20261008-v4","agronomy":{"modelVersion":"root-water-condition-proxy-20261008-v2","origin":"SIMULATED_ROOT_WATER_BALANCE","calibrated":false,"measured":false,"soilMoistureUnit":"%vol","soilMoistureVwcPct":29.863797934398633,"rootWaterL":18814.19269867114,"rootVolumeL":63000.0,"areaM2":252.0,"rootDepthM":0.25,"rootDepthMeaning":"虚拟有效储水层厚度，非番茄最大根深","integrationMinutes":1,"vpdKpa":0.2052534093837146,"fieldCapacityVwcPct":34.0,"saturationVwcPct":46.0,"dryThresholdVwcPct":24.0,"wetThresholdVwcPct":36.0,"waterStressFactor":1.0,"waterUsedL":0.0,"drainageL":0.0,"evapotranspirationL":85.80730132885013,"wetExposureMinutes":0.0,"dryExposureMinutes":0.0,"continuousWetMinutes":0.0,"continuousDryMinutes":0.0,"canopyWetnessProxy":0.6406703062140847,"canopyWetMinutes":37.0,"evapotranspirationRateMmDay":0.5184956855054108,"elapsedMinutes":300,"waterBalanceResidualL":1.0913936421275139E-11,"rootCondition":"SUITABLE","diseaseConditions":[{"code":"WARM_LEAF_WET","title":"叶斑类病害湿润条件提示","level":"MEDIUM","continuousExposureMinutes":37.0,"cumulativeExposureMinutes":37.0,"condition":"20–30°C且冠层湿润代理≥0.55","review":"复查病斑是否扩展；病叶处置和病因判断需要人工登记","origin":"SIMULATED_CONDITION_RULE","validatedProbability":false,"diagnosis":false,"calibrated":false,"alertAfterMinutes":240,"thresholdPurpose":"CONDITION_REVIEW_WINDOW"}],"diseaseConditionLevel":"MEDIUM","riskLevel":"MEDIUM"},"shadowAgronomy":{"modelVersion":"root-water-condition-proxy-20261008-v2","origin":"SIMULATED_ROOT_WATER_BALANCE","calibrated":false,"measured":false,"soilMoistureUnit":"%vol","soilMoistureVwcPct":29.8284731736539,"rootWaterL":18791.93809940196,"waterStressFactor":1.0,"rootCondition":"SUITABLE","canopyWetnessProxy":0.4002391780484856,"canopyWetMinutes":0.0,"wetExposureMinutes":0.0,"dryExposureMinutes":0.0,"diseaseConditionLevel":"LOW","riskLevel":"LOW","detailsSummarized":true},"resources":{"origin":"SIMULATED_DEVICE_ACCOUNTING","calibrated":false,"irrigationWaterL":0.0,"coolingWaterL":0.0,"totalWaterL":0.0,"electricityKwh":3.3564999999999996,"co2Kg":0.0,"waterUsedL":0.0,"energyKwh":3.3564999999999996,"note":"按设备出力×模拟分钟与假设容量计量；不是电表、水表或费用实测。"},"effects":[{"device":"HUMAN_INSPECTION","title":"复查病斑与叶面","observed":"当前仅计算病害适生条件；未计算病斑面积、病原量或治愈率","status":"MANUAL_REQUIRED","origin":"REQUIRES_HUMAN_OBSERVATION","fieldValidated":false}],"actionEffects":"滴灌按出力与时间加入根区水量；蒸散和排水减少存水，缺水/过湿影响虚拟生长；环流降低冠层湿润代理但不改变棚均温湿度；遮阳/补光影响PPFD及辐射热差；加热/湿帘影响温度和水汽；通风/排风与模拟边界交换温…（摘要省略）","devices":{"HEATING":false,"IRRIGATION":false,"VENTILATION":false,"SUPPLEMENTAL_LIGHT":false,"SHADE":true,"CO2_SUPPLY":false,"ROOF_VENT":true,"EXHAUST_FAN":true,"COOLING_PAD":false,"CIRCULATION_FAN":true},"deviceDuty":{"HEATING":0.0,"IRRIGATION":0.0,"VENTILATION":0.0,"SUPPLEMENTAL_LIGHT":0.0,"SHADE":0.5,"CO2_SUPPLY":0.0,"ROOF_VENT":0.6,"EXHAUST_FAN":0.6,"COOLING_PAD":0.0,"CIRCULATION_FAN":0.5},"deviceHealth":{"HEATING":true,"IRRIGATION":true,"VENTILATION":true,"SUPPLEMENTAL_LIGHT":true,"SHADE":true,"CO2_SUPPLY":true,"ROOF_VENT":true,"EXHAUST_FAN":true,"COOLING_PAD":true,"CIRCULATION_FAN":true},"growth":{"plantHeightCm":48.794820031258986,"referenceHeightCm":48.70875293432962,"withoutInterventionHeightCm":48.82572198968395,"lai":1.2975199832953062,"wTotal":156.2932526077846,"wFruit":0.0,"stage":"SEEDLING","fieldValidated":false,"rootWaterStressFactor":1.0,"shadowRootWaterStressFactor":1.0,"withoutInterventionWTotal":156.4525200063482,"withoutInterventionWFruit":0.0,"origin":"SIMULATED_RESPONSE_ANCHORED_TO_ARRIVED_REFERENCE"},"parameterCatalogReference":{"sha256":"9297e1726e028f4603c12de9605c45ed1005999e63d0f6caa2ff324d4e229f17","catalogKey":"parameterCatalogs.9297e1726e028f4603c12de9605c45ed1005999e63d0f6caa2ff324d4e229f17","entryCount":65,"parameterVersion":"m3-cross-year-2026-10-02T12-01-49.808-a1e148ee","responseModelVersion":"m3-scenario-agronomy-20261008-v4"},"explanationReference":{"sha256":"ad65b7d19cd889b82a3aa662b6e9988c989f5da58040e0fd24817f1ef63384cd","fullDescriptionsRetained":true,"catalogKey":"decisionSnapshots.ad65b7d19cd889b82a3aa662b6e9988c989f5da58040e0fd24817f1ef63384cd"},"parameterValuesInCatalog":true},"contextTruncated":true,"summaryNote":"仅展示本轮关键数据与近期记录，省略部分不可推测；完整信息保留在任务档案。"}}}

event:step
data:{"type":"step","stepNo":1,"toolName":"knowledge.search","message":"knowledge.search 完成，引用 5 条，耗时 36ms","data":{"citations":[{"index":1,"diseaseName":"番茄早疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.030798389007344232,"sourceTable":"disease","sourceId":85,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄早疫病；字段：症状。各生育期都可发病，为害叶片、茎、花、果等，以叶片和茎叶分枝处最易发病。(1)叶片。病初现水渍状暗褐色病斑，扩大后近圆形，有同心轮纹，边缘多具浅绿色或黄色晕环。潮湿时病斑长出黑霉。多从植株下部叶片开始，逐渐向上发展。严重时，多个病斑联成不规则大斑，造成叶片早枯。(2)叶柄。叶片发病时先从下部叶片开始，逐渐向上部叶片发展。病斑椭圆形，稍凹陷，暗褐色，有轮纹。(3)茎部。多在分枝处产生褐色至深褐色不规则圆形或椭圆形病斑，表面生灰黑色霉状物。幼苗期茎基部发病，严重时病斑绕茎1周。刮大风时，茎杆、枝条易从发病处折断。(4)果实。青果发病多在花萼处或脐部，病斑黑褐色近圆凹陷，后期从果蒂裂缝处或果柄处发病，病斑部较硬，一般不腐烂，后期有时从病斑处开裂。在果蒂附近形成圆形或椭圆形暗褐色病斑，病斑凹陷，有同心轮纹，斑面着生黑色霉层。 [侵染](1)越冬与初侵染源。病原以菌丝体或分生孢子在病残体或种子表面越冬，附着在种子上的病原可存活2年。(2)传播特点。播种带菌种子，种子萌发时即可发病。在大棚内，病原主要是种子携带分生孢子成为初侵染，土壤中带有分生孢子，或者从通…","label":"[1] 番茄早疫病 · 症状 · 片段0"},{"index":2,"diseaseName":"番茄早疫病","cropType":"番茄","fieldType":"CAUSE","chunkNo":0,"startOffset":0,"score":0.030330882352941176,"sourceTable":"disease","sourceId":85,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄早疫病；字段：诱因。早疫病的发生与气温、相对湿度、降雨量、叶片生理年龄及品种耐病性有直接关系。(1)品种因素。抗病性有相当差异。(2)气候因素。湿度是病害发生与流行的主导因素。湿度80%以上，温度20～25℃最易发病。田间发病前5天均温为21℃，相对湿度大于70%的时间超过2天，早疫病即可发生。阴雨天气造成环境高湿易发病。(3)栽培因素。连作，栽种密度过大，基肥不足，灌水多或低洼积水，结果过多，植株生长衰弱等，都有利于该病暴发流行。春季保护地栽培，番茄定植后，昼夜温差大，叶面有水膜，利于病害发生。","label":"[2] 番茄早疫病 · 诱因 · 片段0"},{"index":3,"diseaseName":"阴雨弱光恢复后的作物观察","cropType":"番茄","fieldType":"ENVIRONMENT","chunkNo":0,"startOffset":0,"score":0.029877369007803793,"sourceTable":"guidance_weather_moa_2024","sourceId":3,"sourceCode":"guidance-weather-moa-2024","sourceName":"农业农村部：2024年冬季蔬菜生产技术指导意见","sourceType":"B","sourceUrl":"https://www.moa.gov.cn/gk/nszd_1/nszd_2/202411/t20241113_6466168.htm","sourceVersion":"2024-11-13; reviewed-2026-10-02","snippet":"作物：番茄；主题：阴雨弱光恢复后的作物观察；字段：环境调控。连续阴雨需关注弱光、温湿变化及植株恢复。改善天气后仍检查根区、叶片和长势；天气结束不能直接宣称病害或作物风险解除。该资料为2024生产指导，不是当前天气预报。","label":"[3] 阴雨弱光恢复后的作物观察 · 环境调控 · 片段0"},{"index":4,"diseaseName":"番茄晚疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.02946236559139785,"sourceTable":"disease","sourceId":86,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄晚疫病；字段：症状。叶、茎、果均可受害，但以叶片和青果受害严重。(1)叶片。多从植株下部叶尖或叶缘开始发病，以后逐渐向上部叶片和果实蔓延。初为暗绿色水浸状不整形病斑，病健交界处无明显界限，扩大后转为褐色。空气潮湿时，病斑会迅速扩展，叶背病斑边缘可见一层白色霉状物。空气干燥时病斑呈绿褐色，后变暗褐色并逐渐干枯。(2)茎部。病斑由水渍状变暗褐色至黑褐色，稍向下凹陷，病茎组织变软，植株萎蔫，严重的病部折断造成茎叶枯死。(3)果实。多从未着色前的青果近果柄处的果面开始，病斑呈不明显的油浸状大斑，逐渐向四周发展，后期逐渐变为深褐色，病斑稍凹陷，病果质硬不软腐，边缘不变红，潮湿时病斑表面产生一层白色霉状物。果实贮藏、运输、销售期间还可继续受害，严重时可导致番茄大量毁坏。 [侵染](1)越冬与初侵染源。病原主要随病残体在土壤中越冬，也可以在冬季栽培的番茄及马铃薯块茎中越冬。(2)传播特点。条件适宜时，借气流或雨水传播到番茄植株上，在田间形成中心病株。病原的菌丝在寄主细胞间或细胞内扩展蔓延，经3～4天潜育后，病部长出菌丝和孢子囊，并借风雨传播进行多次侵染。从气孔或表皮直接侵入。菌…","label":"[4] 番茄晚疫病 · 症状 · 片段0"},{"index":5,"diseaseName":"番茄晚疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.029051670471052088,"sourceTable":"curated_tomato","sourceId":8,"sourceCode":"ucipm-tomato-late-blight","sourceName":"UC IPM Tomato Pest Management Guidelines: Late Blight","sourceType":"B","sourceUrl":"https://ipm.ucanr.edu/agriculture/tomato/late-blight/","sourceVersion":"text-2013-12-reviewed-2026-09-24","snippet":"作物：番茄；病害：番茄晚疫病；字段：症状。叶片初现小块水渍状病斑，随后可迅速扩为紫褐色油渍状斑；叶背病斑周围可能出现灰白色霉层。受侵果实褐变，未继发腐烂时仍较坚实。","label":"[5] 番茄晚疫病 · 症状 · 片段0"}],"stepCitations":[{"index":1,"diseaseName":"番茄早疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.030798389007344232,"sourceTable":"disease","sourceId":85,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄早疫病；字段：症状。各生育期都可发病，为害叶片、茎、花、果等，以叶片和茎叶分枝处最易发病。(1)叶片。病初现水渍状暗褐色病斑，扩大后近圆形，有同心轮纹，边缘多具浅绿色或黄色晕环。潮湿时病斑长出黑霉。多从植株下部叶片开始，逐渐向上发展。严重时，多个病斑联成不规则大斑，造成叶片早枯。(2)叶柄。叶片发病时先从下部叶片开始，逐渐向上部叶片发展。病斑椭圆形，稍凹陷，暗褐色，有轮纹。(3)茎部。多在分枝处产生褐色至深褐色不规则圆形或椭圆形病斑，表面生灰黑色霉状物。幼苗期茎基部发病，严重时病斑绕茎1周。刮大风时，茎杆、枝条易从发病处折断。(4)果实。青果发病多在花萼处或脐部，病斑黑褐色近圆凹陷，后期从果蒂裂缝处或果柄处发病，病斑部较硬，一般不腐烂，后期有时从病斑处开裂。在果蒂附近形成圆形或椭圆形暗褐色病斑，病斑凹陷，有同心轮纹，斑面着生黑色霉层。 [侵染](1)越冬与初侵染源。病原以菌丝体或分生孢子在病残体或种子表面越冬，附着在种子上的病原可存活2年。(2)传播特点。播种带菌种子，种子萌发时即可发病。在大棚内，病原主要是种子携带分生孢子成为初侵染，土壤中带有分生孢子，或者从通…","label":"[1] 番茄早疫病 · 症状 · 片段0"},{"index":2,"diseaseName":"番茄早疫病","cropType":"番茄","fieldType":"CAUSE","chunkNo":0,"startOffset":0,"score":0.030330882352941176,"sourceTable":"disease","sourceId":85,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄早疫病；字段：诱因。早疫病的发生与气温、相对湿度、降雨量、叶片生理年龄及品种耐病性有直接关系。(1)品种因素。抗病性有相当差异。(2)气候因素。湿度是病害发生与流行的主导因素。湿度80%以上，温度20～25℃最易发病。田间发病前5天均温为21℃，相对湿度大于70%的时间超过2天，早疫病即可发生。阴雨天气造成环境高湿易发病。(3)栽培因素。连作，栽种密度过大，基肥不足，灌水多或低洼积水，结果过多，植株生长衰弱等，都有利于该病暴发流行。春季保护地栽培，番茄定植后，昼夜温差大，叶面有水膜，利于病害发生。","label":"[2] 番茄早疫病 · 诱因 · 片段0"},{"index":3,"diseaseName":"阴雨弱光恢复后的作物观察","cropType":"番茄","fieldType":"ENVIRONMENT","chunkNo":0,"startOffset":0,"score":0.029877369007803793,"sourceTable":"guidance_weather_moa_2024","sourceId":3,"sourceCode":"guidance-weather-moa-2024","sourceName":"农业农村部：2024年冬季蔬菜生产技术指导意见","sourceType":"B","sourceUrl":"https://www.moa.gov.cn/gk/nszd_1/nszd_2/202411/t20241113_6466168.htm","sourceVersion":"2024-11-13; reviewed-2026-10-02","snippet":"作物：番茄；主题：阴雨弱光恢复后的作物观察；字段：环境调控。连续阴雨需关注弱光、温湿变化及植株恢复。改善天气后仍检查根区、叶片和长势；天气结束不能直接宣称病害或作物风险解除。该资料为2024生产指导，不是当前天气预报。","label":"[3] 阴雨弱光恢复后的作物观察 · 环境调控 · 片段0"},{"index":4,"diseaseName":"番茄晚疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.02946236559139785,"sourceTable":"disease","sourceId":86,"sourceCode":"legacy-disease-db","sourceName":"项目历史病害库 cropdisease.disease 表（层级 E：本项目旧库）","sourceType":"E","sourceUrl":null,"sourceVersion":"2026-09-23","snippet":"作物：番茄；病害：番茄晚疫病；字段：症状。叶、茎、果均可受害，但以叶片和青果受害严重。(1)叶片。多从植株下部叶尖或叶缘开始发病，以后逐渐向上部叶片和果实蔓延。初为暗绿色水浸状不整形病斑，病健交界处无明显界限，扩大后转为褐色。空气潮湿时，病斑会迅速扩展，叶背病斑边缘可见一层白色霉状物。空气干燥时病斑呈绿褐色，后变暗褐色并逐渐干枯。(2)茎部。病斑由水渍状变暗褐色至黑褐色，稍向下凹陷，病茎组织变软，植株萎蔫，严重的病部折断造成茎叶枯死。(3)果实。多从未着色前的青果近果柄处的果面开始，病斑呈不明显的油浸状大斑，逐渐向四周发展，后期逐渐变为深褐色，病斑稍凹陷，病果质硬不软腐，边缘不变红，潮湿时病斑表面产生一层白色霉状物。果实贮藏、运输、销售期间还可继续受害，严重时可导致番茄大量毁坏。 [侵染](1)越冬与初侵染源。病原主要随病残体在土壤中越冬，也可以在冬季栽培的番茄及马铃薯块茎中越冬。(2)传播特点。条件适宜时，借气流或雨水传播到番茄植株上，在田间形成中心病株。病原的菌丝在寄主细胞间或细胞内扩展蔓延，经3～4天潜育后，病部长出菌丝和孢子囊，并借风雨传播进行多次侵染。从气孔或表皮直接侵入。菌…","label":"[4] 番茄晚疫病 · 症状 · 片段0"},{"index":5,"diseaseName":"番茄晚疫病","cropType":"番茄","fieldType":"SYMPTOM","chunkNo":0,"startOffset":0,"score":0.029051670471052088,"sourceTable":"curated_tomato","sourceId":8,"sourceCode":"ucipm-tomato-late-blight","sourceName":"UC IPM Tomato Pest Management Guidelines: Late Blight","sourceType":"B","sourceUrl":"https://ipm.ucanr.edu/agriculture/tomato/late-blight/","sourceVersion":"text-2013-12-reviewed-2026-09-24","snippet":"作物：番茄；病害：番茄晚疫病；字段：症状。叶片初现小块水渍状病斑，随后可迅速扩为紫褐色油渍状斑；叶背病斑周围可能出现灰白色霉层。受侵果实褐变，未继发腐烂时仍较坚实。","label":"[5] 番茄晚疫病 · 症状 · 片段0"}],"degraded":false,"degradedReason":null,"lowScore":false,"bm25HitCount":10,"durationMs":36,"error":null,"input":{"query":"番茄连续阴雨 叶片褐色病斑 扩展 早疫病 防治 通风降湿","crop":"番茄","topN":5},"note":null,"mapping":null}}

